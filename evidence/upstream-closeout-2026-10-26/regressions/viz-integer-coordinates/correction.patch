diff --git a/tests/unit_tests/test_closeout_viz_integer_coordinates.py b/tests/unit_tests/test_closeout_viz_integer_coordinates.py
new file mode 100644
index 0000000..47d9d94
--- /dev/null
+++ b/tests/unit_tests/test_closeout_viz_integer_coordinates.py
@@ -0,0 +1,12 @@
+"""Focused current-upstream regression; generated arrays only."""
+import numpy as np
+import pandas as pd
+import pytest
+
+
+def test_integer_coordinates_preserve_fractional_millimetres():
+    from moseq2_viz.scalars.util import convert_pxs_to_mm
+    coords = np.array([[257, 213], [258, 214]], dtype=np.int64)
+    actual = convert_pxs_to_mm(coords)
+    np.testing.assert_allclose(actual, convert_pxs_to_mm(coords.astype(float)))
+    assert np.issubdtype(actual.dtype, np.floating)
